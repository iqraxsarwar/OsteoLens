# Production defaults to serving API and frontend from the same origin.
# Leave VITE_OSTEOLENS_API_URL unset for the supported single-origin deployment.
OSTEOLENS_PUBLIC_MODE=1
OSTEOLENS_PUBLIC_ORIGIN=https://your-public-hostname.example
# Generate a random secret locally. Never commit its value.
OSTEOLENS_SESSION_SECRET_FILE=/run/secrets/osteolens_session
OSTEOLENS_REPORT_DATA_DIR=/data/public-reports
OSTEOLENS_OLLAMA_MODEL=qwen2.5:0.5b
OSTEOLENS_OLLAMA_URL=http://127.0.0.1:11434
