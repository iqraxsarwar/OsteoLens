# Copy to /etc/osteolens/server.env on the selected server, never into Git.
# Set the real HTTPS origin after DNS and provider review are complete.
OSTEOLENS_PUBLIC_MODE=1
OSTEOLENS_PUBLIC_ORIGIN=https://REPLACE_WITH_APPROVED_HOSTNAME
OSTEOLENS_PRIVACY_CONFIG=/etc/osteolens/privacy-config.json
OSTEOLENS_SESSION_SECRET_FILE=/etc/osteolens/session-secret
OSTEOLENS_REPORT_DATA_DIR=/var/lib/osteolens/public-reports
OSTEOLENS_RAG_DATA_DIR=/var/lib/osteolens/rag
OSTEOLENS_MODEL_PATH=/opt/osteolens/models/checkpoints/osteolens_btxrd_resnet18.pth
OSTEOLENS_OLLAMA_MODEL=qwen2.5:0.5b
OSTEOLENS_OLLAMA_URL=http://127.0.0.1:11434
